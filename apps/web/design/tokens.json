{
  "color-fg": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.1216, 0.1608, 0.2157], "hex": "#1f2937" }, "$description": "Default text colour; AA on color-bg." },
  "color-fg-muted": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.2941, 0.3333, 0.3882], "hex": "#4b5563" }, "$description": "Secondary text, hints." },
  "color-bg": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }, "$description": "Page and surface background." },
  "color-bg-subtle": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.9529, 0.9569, 0.9647], "hex": "#f3f4f6" }, "$description": "Quiet fills: hover, disabled, skeleton, table header." },
  "color-border": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.8196, 0.8353, 0.8588], "hex": "#d1d5db" }, "$description": "Decorative borders and dividers." },
  "color-border-strong": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.4196, 0.4471, 0.502], "hex": "#6b7280" }, "$description": "Borders of interactive controls." },
  "color-primary": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.1451, 0.3882, 0.9216], "hex": "#2563eb" }, "$description": "Brand and primary action colour." },
  "color-primary-hover": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1d4ed8" }, "$description": "Primary hover and focus ring." },
  "color-on-primary": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }, "$description": "Text on primary fills." },
  "color-danger": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.7255, 0.1098, 0.1098], "hex": "#b91c1c" }, "$description": "Destructive actions and errors." },
  "color-danger-hover": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.6, 0.1059, 0.1059], "hex": "#991b1b" }, "$description": "Danger hover and danger text on tinted fill." },
  "color-on-danger": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }, "$description": "Text on danger fills." },
  "color-danger-bg": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.9961, 0.8863, 0.8863], "hex": "#fee2e2" }, "$description": "Tinted danger surface." },
  "color-success-fg": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.0863, 0.3961, 0.2039], "hex": "#166534" }, "$description": "Success text and border." },
  "color-success-bg": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.8627, 0.9882, 0.9059], "hex": "#dcfce7" }, "$description": "Tinted success surface." },
  "color-warning-fg": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.5216, 0.302, 0.0549], "hex": "#854d0e" }, "$description": "Warning text and border." },
  "color-warning-bg": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.9961, 0.9765, 0.7647], "hex": "#fef9c3" }, "$description": "Tinted warning surface." },
  "color-info-fg": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.1176, 0.251, 0.6863], "hex": "#1e40af" }, "$description": "Info text and border." },
  "color-info-bg": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.8588, 0.9176, 0.9961], "hex": "#dbeafe" }, "$description": "Tinted info surface." },

  "space-1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" }, "$description": "Tight gaps." },
  "space-2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" }, "$description": "Default small gap." },
  "space-3": { "$type": "dimension", "$value": { "value": 16, "unit": "px" }, "$description": "Default gap and card padding." },
  "space-4": { "$type": "dimension", "$value": { "value": 24, "unit": "px" }, "$description": "Section gap." },
  "space-5": { "$type": "dimension", "$value": { "value": 32, "unit": "px" }, "$description": "Large section gap." },
  "space-6": { "$type": "dimension", "$value": { "value": 48, "unit": "px" }, "$description": "Page-level spacing." },

  "radius-sm": { "$type": "dimension", "$value": { "value": 4, "unit": "px" }, "$description": "Chips, checkboxes, tooltips." },
  "radius-md": { "$type": "dimension", "$value": { "value": 8, "unit": "px" }, "$description": "Buttons and inputs." },
  "radius-lg": { "$type": "dimension", "$value": { "value": 12, "unit": "px" }, "$description": "Cards, modals, drawers." },
  "radius-full": { "$type": "dimension", "$value": { "value": 999, "unit": "px" }, "$description": "Pills and circles." },

  "font-size-sm": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" }, "$description": "Hints, badges, table cells." },
  "font-size-md": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" }, "$description": "Body text." },
  "font-size-lg": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" }, "$description": "Section headings." },
  "font-size-xl": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" }, "$description": "Page titles." },

  "border-width": { "$type": "dimension", "$value": { "value": 1, "unit": "px" }, "$description": "Default border." },
  "border-width-strong": { "$type": "dimension", "$value": { "value": 2, "unit": "px" }, "$description": "Focus ring, selected tab, spinner." },
  "control-height-sm": { "$type": "dimension", "$value": { "value": 32, "unit": "px" }, "$description": "Small button height." },
  "control-height": { "$type": "dimension", "$value": { "value": 40, "unit": "px" }, "$description": "Default control height." },
  "control-height-lg": { "$type": "dimension", "$value": { "value": 48, "unit": "px" }, "$description": "Large button height." },
  "check-size": { "$type": "dimension", "$value": { "value": 18, "unit": "px" }, "$description": "Checkbox and radio size." },
  "switch-width": { "$type": "dimension", "$value": { "value": 40, "unit": "px" }, "$description": "Switch track width." },
  "switch-height": { "$type": "dimension", "$value": { "value": 22, "unit": "px" }, "$description": "Switch track height." },
  "switch-thumb": { "$type": "dimension", "$value": { "value": 16, "unit": "px" }, "$description": "Switch thumb size." },
  "avatar-size": { "$type": "dimension", "$value": { "value": 40, "unit": "px" }, "$description": "Avatar diameter." },
  "spinner-size": { "$type": "dimension", "$value": { "value": 24, "unit": "px" }, "$description": "Spinner diameter." },
  "skeleton-height": { "$type": "dimension", "$value": { "value": 16, "unit": "px" }, "$description": "Skeleton line height." },
  "menu-min-width": { "$type": "dimension", "$value": { "value": 200, "unit": "px" }, "$description": "Menu and dropdown width." },
  "modal-width": { "$type": "dimension", "$value": { "value": 480, "unit": "px" }, "$description": "Modal max width." },
  "drawer-width": { "$type": "dimension", "$value": { "value": 360, "unit": "px" }, "$description": "Drawer width." },
  "toast-width": { "$type": "dimension", "$value": { "value": 320, "unit": "px" }, "$description": "Toast max width." },
  "tooltip-max-width": { "$type": "dimension", "$value": { "value": 240, "unit": "px" }, "$description": "Tooltip max width." },
  "grid-min": { "$type": "dimension", "$value": { "value": 240, "unit": "px" }, "$description": "Minimum column width of .grid." },
  "content-max-width": { "$type": "dimension", "$value": { "value": 1200, "unit": "px" }, "$description": "Max width of page content." },
  "sample-frame-height": { "$type": "dimension", "$value": { "value": 320, "unit": "px" }, "$description": "Height of overlay sample frames in the style guide." },

  "font-family-sans": { "$type": "fontFamily", "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif", "$description": "UI text." },
  "font-family-mono": { "$type": "fontFamily", "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "$description": "Identifiers and code." },
  "font-weight-regular": { "$type": "fontWeight", "$value": 400 },
  "font-weight-medium": { "$type": "fontWeight", "$value": 500 },
  "font-weight-bold": { "$type": "fontWeight", "$value": 700 },
  "line-height-base": { "$type": "number", "$value": 1.5, "$description": "Body line height." },
  "line-height-tight": { "$type": "number", "$value": 1.25, "$description": "Headings and controls." },
  "opacity-disabled": { "$type": "number", "$value": 0.5, "$description": "Disabled controls." },
  "opacity-backdrop": { "$type": "number", "$value": 0.5, "$description": "Backdrop behind modals." },
  "motion-spin": { "$type": "number", "$value": 0.8, "$description": "Seconds per spinner turn." },
  "z-dropdown": { "$type": "number", "$value": 10 },
  "z-backdrop": { "$type": "number", "$value": 20 },
  "z-overlay": { "$type": "number", "$value": 30 },

  "tap-target": { "$type": "dimension", "$value": { "value": 44, "unit": "px" }, "$description": "Minimum touch target for shell links and buttons." },

  "button-primary-background": { "$type": "color", "$value": "{color-primary}" },
  "button-primary-background-hover": { "$type": "color", "$value": "{color-primary-hover}" },
  "button-primary-color": { "$type": "color", "$value": "{color-on-primary}" },
  "button-primary-border": { "$type": "color", "$value": "{color-primary}" },
  "button-secondary-background": { "$type": "color", "$value": "{color-bg}" },
  "button-secondary-background-hover": { "$type": "color", "$value": "{color-bg-subtle}" },
  "button-secondary-color": { "$type": "color", "$value": "{color-fg}" },
  "button-secondary-border": { "$type": "color", "$value": "{color-border-strong}" },
  "button-ghost-background-hover": { "$type": "color", "$value": "{color-bg-subtle}" },
  "button-ghost-color": { "$type": "color", "$value": "{color-primary}" },
  "button-danger-background": { "$type": "color", "$value": "{color-danger}" },
  "button-danger-background-hover": { "$type": "color", "$value": "{color-danger-hover}" },
  "button-danger-color": { "$type": "color", "$value": "{color-on-danger}" },
  "button-danger-border": { "$type": "color", "$value": "{color-danger}" },
  "button-default-radius": { "$type": "dimension", "$value": "{radius-md}" },
  "button-default-height": { "$type": "dimension", "$value": "{control-height}" },
  "button-default-padding-x": { "$type": "dimension", "$value": "{space-3}" },
  "card-default-background": { "$type": "color", "$value": "{color-bg}" },
  "card-default-border": { "$type": "color", "$value": "{color-border}" },
  "card-default-color": { "$type": "color", "$value": "{color-fg}" },
  "card-default-radius": { "$type": "dimension", "$value": "{radius-lg}" },
  "card-default-padding": { "$type": "dimension", "$value": "{space-3}" }
}
