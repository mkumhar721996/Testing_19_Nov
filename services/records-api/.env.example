# PostgreSQL connection (required)
DATABASE_URL=
# Secret used to sign session tokens (required, no default)
SESSION_SECRET=
# Session lifetime in seconds
SESSION_TTL_SECONDS=3600
# entra (default) or fake (only when NODE_ENV=test)
IDENTITY_PROVIDER=entra
# Needed when IDENTITY_PROVIDER=entra
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Payments (all optional)
# Verified Amazon SES sender; when unset a logging mailer is used
SES_FROM_ADDRESS=
AWS_REGION=
UNPAID_SWEEP_INTERVAL_MS=60000
